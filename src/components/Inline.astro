---
import { inlineParts } from '../lib/inline';
import { pathFor, type Locale } from '../data/site';
interface Props {
  text: string;
  locale: Locale;
  externalNewTab?: boolean;
}
const { text, locale, externalNewTab = false } = Astro.props;
---

{inlineParts(text).map((part) => {
  if (!part.target) return part.text;
  const [page, anchor] = part.target.split('#');
  const href =
    part.target.startsWith('https://') || part.target.startsWith('#')
      ? part.target
      : `${pathFor(locale, page)}${anchor ? `#${anchor}` : ''}`;
  return (
    <a
      class="inline-link"
      href={href}
      target={
        externalNewTab && href.startsWith('https://') ? '_blank' : undefined
      }
      rel={
        externalNewTab && href.startsWith('https://')
          ? 'noopener noreferrer'
          : undefined
      }
    >
      {part.text}
    </a>
  );
})}
