---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../data/site';
const t = copy.en;
---

<BaseLayout locale="en" title="404">
  <div class="container not-found">
    <p class="eyebrow">404</p>
    <h1>{t.notFound}</h1>
    <p>{t.notFoundText}</p>
    <a href="/" class="button">
      {t.home}
    </a>
  </div>
</BaseLayout>

<style>
  :global(.site-footer) {
    background: var(--night);
  }
</style>
